{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure (MSVC x64)",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build-vs",
        "-G",
        "Visual Studio 17 2022",
        "-A",
        "x64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build (F5 Debug)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-vs",
        "--config",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake Configure (MSVC x64)",
      "dependsOrder": "sequence",
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Clean build artifacts",
      "type": "shell",
      "command": "if exist \"${workspaceFolder}\\build-vs\" rmdir /s /q \"${workspaceFolder}\\build-vs\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "problemMatcher": []
    }
  ]
}
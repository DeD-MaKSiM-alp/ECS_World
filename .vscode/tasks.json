{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build main.cpp (MSVC)",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\build_msvc.bat",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Clean build artifacts",
      "type": "shell",
      "command": "del /f /q \"${workspaceFolder}\\main.exe\" \"${workspaceFolder}\\main.obj\" \"${workspaceFolder}\\main.pdb\" \"${workspaceFolder}\\main.ilk\" \"${workspaceFolder}\\vc140.pdb\" 2>nul",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "problemMatcher": []
    }
  ]
}